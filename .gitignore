# Ignore the contents of .claude, NOT the directory itself — git never
# descends into an excluded directory, so a negation inside one is dead.
.claude/*
# …but the PPE skill is part of the project: updating the engine and
# updating the instructions for driving it should be the same commit.
!.claude/skills/
db_backups/
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
db/production_spec_shots/
**/__pycache__/
*.pyc
scripts/webapp.log
.env.local
